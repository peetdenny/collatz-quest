# Public demo mode is the default when these are blank.
# To enable private family cloud save, copy this file to .env.local and fill in:

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Use a private, non-guessable profile id for a family save.
# Example: family-2026-private-code
VITE_FIREBASE_PROFILE_ID=
